parameters:
	level: 5
	paths:
		- crawlwatch-ai-bot-insights.php
		- uninstall.php
		- includes
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	scanFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
	treatPhpDocTypesAsCertain: false
	ignoreErrors:
		# Core documents null $parent_slug as a hidden page; the stub types it string.
		-
			message: '#Parameter \#1 \$parent_slug of function add_submenu_page expects string, null given#'
			path: includes/class-crawlwatch-admin.php
			count: 1
	parallel:
		maximumNumberOfProcesses: 2
